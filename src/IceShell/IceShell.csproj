<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>IceShell</PackageId>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageIcon>IceShell_128x.png</PackageIcon>
    <ApplicationIcon>IceShell.ico</ApplicationIcon>
    <AssemblyName>iceshell</AssemblyName>
    <RootNamespace>IceShell</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="lang/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Content Include="IceShell.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="IceShell_128x.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IceShell.Batching\IceShell.Batching.csproj" />
    <ProjectReference Include="..\IceShell.Core\IceShell.Core.csproj" />
    <ProjectReference Include="..\IceShell.Platform.Linux\IceShell.Platform.Linux.csproj" />
    <ProjectReference Include="..\IceShell.Platform.Windows\IceShell.Platform.Windows.csproj" />
  </ItemGroup>

</Project>